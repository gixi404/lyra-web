---
import logo from "../assets/logo.png";
---

<footer class="site-footer w-full border-t border-[var(--border-subtle)] bg-[var(--bg-primary)] mt-auto pt-12 pb-14">
  <div class="container">
    <div class="flex flex-col md:flex-row flex-wrap items-start justify-between gap-8 mb-10">
      <div class="max-w-[320px]">
        <div class="inline-flex items-center gap-2 font-bold text-[1.1rem] mb-2.5 text-[var(--text-primary)]">
          <span>Lyra</span>
          <img
            src={logo.src}
            alt="Isotipo Lyra"
            class="w-[18px] h-[18px] object-contain"
            width={18}
            height={18}
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="text-[0.9rem] text-[var(--text-primary)] leading-relaxed">
          Editor de notas minimalista y local. Diseñado para la concentración pura.
        </p>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="text-[0.82rem] font-bold uppercase tracking-wider text-[var(--text-primary)] mb-1">
          Navegación
        </span>
        <a href="/#filosofia" class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors">
          Filosofía
        </a>
        <a href="/#descargas" class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors">
          Descargas
        </a>
        <a href="#top" class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors">
          Volver arriba
        </a>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="text-[0.82rem] font-bold uppercase tracking-wider text-[var(--text-primary)] mb-1">
          Proyecto
        </span>
        <a
          href="https://github.com/gixi404/lyra"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors"
        >
          Código en GitHub
        </a>
        <a
          href="https://github.com/gixi404/lyra/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors"
        >
          Historial de versiones
        </a>
        <a
          href="https://github.com/gixi404/lyra/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors"
        >
          Reportar un problema
        </a>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="text-[0.82rem] font-bold uppercase tracking-wider text-[var(--text-primary)] mb-1">
          Legal y Privacidad
        </span>
        <a href="/privacy" class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors">
          Política de Privacidad
        </a>
        <a href="/terms" class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors">
          Términos y Condiciones
        </a>
        <a
          href="https://developers.google.com/terms/api-services-user-data-policy"
          target="_blank"
          rel="noopener noreferrer"
          class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors"
        >
          Google User Data Policy ↗
        </a>
      </div>

      <div class="flex flex-col gap-2.5">
        <span class="text-[0.82rem] font-bold uppercase tracking-wider text-[var(--text-primary)] mb-1">
          Contacto
        </span>
        <a href="mailto:gixi.tsx@gmail.com" class="text-[0.9rem] font-medium text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors">
          gixi.tsx@gmail.com
        </a>
        <span class="text-[0.85rem] font-medium text-[var(--text-primary)] leading-snug">
          Responsable: gixi (desarrollador independiente)
        </span>
        <span class="text-[0.85rem] font-medium text-[var(--text-primary)] leading-snug">
          Mendoza, Argentina
        </span>
      </div>
    </div>

    <div class="flex flex-col md:flex-row flex-wrap items-start md:items-center justify-between border-t border-[var(--border-subtle)] pt-7 text-[0.88rem] font-medium text-[var(--text-primary)] gap-4">
      <div class="flex flex-col gap-1">
        <span>
          Lyra · Software libre bajo Licencia{" "}
          <a
            href="https://unlicense.org"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold underline underline-offset-3 hover:text-[var(--accent)] transition-colors"
          >
            The Unlicense
          </a>
        </span>
        <span>Archivos locales · Google OAuth (drive.file) · Cero telemetría</span>
      </div>
      <div class="flex items-center gap-2">
        <a href="/privacy" class="font-semibold underline underline-offset-3 hover:text-[var(--accent)] transition-colors">
          Privacidad
        </a>
        <span class="text-[var(--text-primary)]">·</span>
        <a href="/terms" class="font-semibold underline underline-offset-3 hover:text-[var(--accent)] transition-colors">
          Términos
        </a>
      </div>
    </div>
  </div>
</footer>
