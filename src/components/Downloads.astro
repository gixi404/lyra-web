---
// Downloads.astro - Tailwind CSS v4
const DOWNLOAD_OPTIONS = [
  {
    platformId: "linux",
    platformName: "Linux",
    note: "Para Debian, Ubuntu, Fedora y universales.",
    type: "linux",
    files: [
      {
        name: "Debian / Ubuntu / Mint",
        format: ".deb",
        url: "https://github.com/gixi404/lyra/releases/download/v2.0.12/Lyra_2.0.12_amd64.deb",
      },
      {
        name: "Fedora / openSUSE / RHEL",
        format: ".rpm",
        url: "https://github.com/gixi404/lyra/releases/download/v2.0.12/Lyra-2.0.12-1.x86_64.rpm",
      },
      {
        name: "Paquete universal portátil",
        format: ".AppImage",
        url: "https://github.com/gixi404/lyra/releases/download/v2.0.12/Lyra_2.0.12_amd64.AppImage",
      },
    ],
  },
  {
    platformId: "windows",
    platformName: "Windows",
    note: "Compatible con Windows 10 y 11 (64 bits).",
    type: "windows",
    files: [
      {
        name: "Instalador MSI",
        format: ".msi",
        url: "https://github.com/gixi404/lyra/releases/download/v2.0.12/Lyra_2.0.12_x64_es-ES.msi",
      },
      {
        name: "Instalador autónomo EXE",
        format: ".exe",
        url: "https://github.com/gixi404/lyra/releases/download/v2.0.12/Lyra_2.0.12_x64-setup.exe",
      },
    ],
  },
  {
    platformId: "macos",
    platformName: "macOS",
    note: "Paquete universal para Apple Silicon e Intel.",
    type: "macos",
    files: [
      {
        name: "Paquete universal DMG",
        format: ".dmg",
        url: "https://github.com/gixi404/lyra/releases/download/v2.0.12/Lyra_2.0.12_universal.dmg",
      },
    ],
  },
];
---

<section id="descargas" class="downloads-section w-full border-t border-[var(--border-subtle)] pt-14 pb-16 md:pt-20 md:pb-24">
  <div class="container">
    <div class="section-head max-w-[680px] mb-10">
      <span class="section-tag inline-block text-[0.78rem] font-bold uppercase tracking-wider text-[var(--accent)] mb-2.5">
        Descargas
      </span>
      <h2 class="section-title text-[clamp(1.55rem,3vw,2.4rem)] font-bold tracking-tight">Instala Lyra</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
      {DOWNLOAD_OPTIONS.map((opt) => (
        <div class="relative flex flex-col rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-card)] p-5 sm:p-7 md:p-8 transition-colors hover:border-[var(--accent)]">
          <div class="flex items-center gap-3 mb-5">
            {opt.type === "linux" && (
              <svg
                class="w-8 h-8 shrink-0 text-[var(--text-primary)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            )}
            {opt.type === "windows" && (
              <svg
                class="w-8 h-8 shrink-0 text-[var(--text-primary)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="8" height="8"></rect>
                <rect x="13" y="3" width="8" height="8"></rect>
                <rect x="3" y="13" width="8" height="8"></rect>
                <rect x="13" y="13" width="8" height="8"></rect>
              </svg>
            )}
            {opt.type === "macos" && (
              <svg
                class="w-8 h-8 shrink-0 text-[var(--text-primary)]"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.95c.61-.75 1.04-1.8 1.01-2.95-.9.04-2 .6-2.65 1.34-.56.63-1.07 1.67-.92 2.76.99.08 2-.45 2.56-1.15z"></path>
              </svg>
            )}
            <h3 class="text-xl font-bold tracking-tight">{opt.platformName}</h3>
          </div>

          <p class="text-[0.92rem] text-[var(--text-primary)] leading-normal mb-7">
            {opt.note}
          </p>

          <div class="flex flex-col gap-3 mt-auto">
            {opt.files.map((file) => (
              <a
                href={file.url}
                data-format={file.format}
                class="download-btn flex items-center justify-between gap-2.5 min-h-[44px] px-3.5 py-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-secondary)] text-[var(--text-primary)] font-medium text-[0.82rem] sm:text-[0.9rem] transition-all hover:border-[var(--accent)] hover:text-[var(--accent)] active:scale-[0.97]"
                download
              >
                <span>{file.name}</span>
                <span class="shrink-0 text-[0.72rem] sm:text-[0.78rem] font-semibold px-1.5 py-0.5 rounded border border-[var(--border-subtle)] bg-[var(--code-bg)] text-[var(--text-primary)]">
                  {file.format}
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    {/* Nota de verificación y seguridad */}
    <div class="security-note flex flex-col md:flex-row items-start gap-3.5 sm:gap-5 rounded-xl p-5 sm:p-6 transition-colors">
      <svg
        class="security-icon shrink-0 w-6 h-6 mt-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <div>
        <h4 class="font-bold text-[0.95rem] text-[var(--text-primary)] mb-1.5">Verificación y código abierto</h4>
        <p class="text-[0.92rem] text-[var(--text-primary)] leading-relaxed">
          Al ser software independiente sin certificados comerciales corporativos, tu sistema puede solicitar confirmación en el primer inicio. El código es 100% abierto y auditable en{" "}
          <a
            href="https://github.com/gixi404/lyra"
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--accent)] underline underline-offset-3 font-semibold hover:text-[var(--accent-hover)] transition-colors"
          >
            GitHub
          </a>
          .
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .security-note {
    border: 1px solid rgba(234, 179, 8, 0.35);
    background-color: rgba(234, 179, 8, 0.12);
  }

  :global([data-theme="light"]) .security-note {
    background-color: rgba(234, 179, 8, 0.22);
    border-color: rgba(180, 83, 9, 0.35);
  }

  .security-icon {
    color: #facc15;
  }

  :global([data-theme="light"]) .security-icon {
    color: #b45309;
  }
</style>

<script is:inline>
  (function() {
    const cacheKey = "lyra_latest_release";
    let releaseData = null;

    try {
      const cached = sessionStorage.getItem(cacheKey);
      if (cached) releaseData = JSON.parse(cached);
    } catch (e) {}

    async function updateReleases() {
      try {
        if (!releaseData) {
          const res = await fetch("https://api.github.com/repos/gixi404/lyra/releases/latest");
          if (res.ok) {
            releaseData = await res.json();
            try {
              sessionStorage.setItem(cacheKey, JSON.stringify(releaseData));
            } catch (e) {}
          }
        }

        if (!releaseData || !Array.isArray(releaseData.assets)) return;

        const assets = releaseData.assets.filter(
          (a) => !a.name.endsWith(".sig") && !a.name.endsWith(".json")
        );

        const debUrl = assets.find((a) => a.name.endsWith(".deb"))?.browser_download_url;
        const rpmUrl = assets.find((a) => a.name.endsWith(".rpm"))?.browser_download_url;
        const appImageUrl = assets.find((a) => a.name.endsWith(".AppImage"))?.browser_download_url;
        const msiUrl = assets.find((a) => a.name.endsWith(".msi"))?.browser_download_url;
        const exeUrl = assets.find((a) => a.name.endsWith(".exe") || a.name.endsWith("-setup.exe"))?.browser_download_url;
        const dmgUrl = assets.find((a) => a.name.endsWith(".dmg"))?.browser_download_url;

        function updateLink(format, url) {
          if (!url) return;
          const links = document.querySelectorAll(`a.download-btn[data-format="${format}"]`);
          links.forEach((l) => l.setAttribute("href", url));
        }

        updateLink(".deb", debUrl);
        updateLink(".rpm", rpmUrl);
        updateLink(".AppImage", appImageUrl);
        updateLink(".msi", msiUrl);
        updateLink(".exe", exeUrl);
        updateLink(".dmg", dmgUrl);
      } catch (err) {
        // En caso de estar sin conexión, se mantienen intactas las URLs de reserva
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", updateReleases);
    } else {
      updateReleases();
    }
  })();
</script>
